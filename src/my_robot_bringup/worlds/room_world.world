<?xml version="1.0" ?>
<!--
  四室 + 走廊的室内环境，供建图 / 分区 / 导航阶段使用。

  布局（俯视，单位 m，原点在地面中心）：
    y
    4  +---------+---------+
       | Room A  | Room B  |
    0  +--[门]---+--[门]---+   <- y = 0 墙，两扇 1 m 门
       |       corridor    |
   -1  +--[门]---+--[门]---+   <- y = -1 墙，两扇 1 m 门
       | Room C  | Room D  |
   -4  +---------+---------+
      -5        0        5   x

  墙体只用简单 box，不依赖 Fuel / 外部模型，离线可加载。
-->
<sdf version="1.8">
  <world name="room_world">

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.75 0.8 1</background>
      <shadows>false</shadows>
    </scene>

    <physics name="default_physics" default="1" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== 外墙 ===== -->
    <model name="wall_outer_north">
      <static>true</static>
      <pose>0 4.1 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.4 0.2 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.4 0.2 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_outer_south">
      <static>true</static>
      <pose>0 -4.1 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.4 0.2 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.4 0.2 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_outer_west">
      <static>true</static>
      <pose>-5.1 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 8.4 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.4 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_outer_east">
      <static>true</static>
      <pose>5.1 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 8.4 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.4 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== y = 0 隔墙（A/B 与走廊之间，门洞 x∈[-3.5,-2.5] 和 [2.5,3.5]） ===== -->
    <model name="wall_y0_west">
      <static>true</static>
      <pose>-4.25 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 0.15 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
          <material><ambient>0.8 0.78 0.72 1</ambient><diffuse>0.8 0.78 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_y0_mid">
      <static>true</static>
      <pose>0 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.0 0.15 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.15 1.5</size></box></geometry>
          <material><ambient>0.8 0.78 0.72 1</ambient><diffuse>0.8 0.78 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_y0_east">
      <static>true</static>
      <pose>4.25 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 0.15 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.15 1.5</size></box></geometry>
          <material><ambient>0.8 0.78 0.72 1</ambient><diffuse>0.8 0.78 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== y = -1 隔墙（走廊与 C/D 之间，门洞 x∈[-2,-1] 和 [1,2]） ===== -->
    <model name="wall_ym1_west">
      <static>true</static>
      <pose>-3.5 -1 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 0.15 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.15 1.5</size></box></geometry>
          <material><ambient>0.8 0.78 0.72 1</ambient><diffuse>0.8 0.78 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_ym1_mid">
      <static>true</static>
      <pose>0 -1 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.15 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.15 1.5</size></box></geometry>
          <material><ambient>0.8 0.78 0.72 1</ambient><diffuse>0.8 0.78 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_ym1_east">
      <static>true</static>
      <pose>3.5 -1 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 0.15 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.15 1.5</size></box></geometry>
          <material><ambient>0.8 0.78 0.72 1</ambient><diffuse>0.8 0.78 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== x = 0 隔墙（A/B 之间，门洞 y∈[2,3]） ===== -->
    <model name="wall_x0_north_low">
      <static>true</static>
      <pose>0 1.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 2.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 2.0 1.5</size></box></geometry>
          <material><ambient>0.8 0.78 0.72 1</ambient><diffuse>0.8 0.78 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_x0_north_high">
      <static>true</static>
      <pose>0 3.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 1.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 1.0 1.5</size></box></geometry>
          <material><ambient>0.8 0.78 0.72 1</ambient><diffuse>0.8 0.78 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== x = 0 隔墙（C/D 之间，门洞 y∈[-2.5,-1.5]） ===== -->
    <model name="wall_x0_south_low">
      <static>true</static>
      <pose>0 -3.25 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 1.5 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 1.5 1.5</size></box></geometry>
          <material><ambient>0.8 0.78 0.72 1</ambient><diffuse>0.8 0.78 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_x0_south_high">
      <static>true</static>
      <pose>0 -1.25 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.5 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.5 1.5</size></box></geometry>
          <material><ambient>0.8 0.78 0.72 1</ambient><diffuse>0.8 0.78 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
